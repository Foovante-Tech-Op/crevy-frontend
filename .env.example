# ─── Public (browser-safe) ───────────────────────────────────────────────────
# URL of the backend Express server (no trailing slash)
NEXT_PUBLIC_API_URL=https://crevy-backend.onrender.com

# API version prefix used by axiosClient
NEXT_PUBLIC_API_VERSION=v1

# Canonical URL of this frontend — used when forwarding the `origin` header
# to BetterAuth in getServerSession (auth-server.ts)
NEXT_PUBLIC_SITE_URL=https://crevy-frontend.netlify.app

# Origin of the R2 (or other S3-compatible) bucket that presigned upload
# URLs point at — e.g. https://<bucket>.<account-id>.r2.cloudflarestorage.com.
# The frontend PUTs files directly to this origin (see StorageService.uploadFile),
# so it must be allowlisted in next.config.ts's CSP connect-src or uploads are
# silently blocked by the browser. The presigned URL itself always comes from
# the backend — this only needs to match its origin.
NEXT_PUBLIC_STORAGE_UPLOAD_ORIGIN=https://your-bucket.your-account-id.r2.cloudflarestorage.com

# Mapbox access token — powers the shared map component used across the app
# (src/lib/map-style.ts, src/components/SpatialCoordinatePicker.tsx), from
# the admin project-registration wizard to the field-agent app. Uses the
# satellite-streets style (detailed imagery + place/road labels) since field
# agents need to make out actual land features when positioning a site.
# Free tier, get one at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ─── Server-only (never exposed to the browser) ──────────────────────────────
# Must exactly match BETTER_AUTH_SECRET in the backend .env / Render env vars
BETTER_AUTH_SECRET=your_secret_here
